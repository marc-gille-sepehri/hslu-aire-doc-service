# hslu-aire-media — extraction worker.
#
# Deliberately shares no layers with Dockerfile.amd64: that image carries Torch
# and the Docling models and needs no LibreOffice; this one carries LibreOffice
# and needs no models. Two images at ~1.5 GB and ~3.2 GB beat one at ~4.5 GB that
# both services pull. See docs/spec-media-extraction.md §13.2.
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    # LibreOffice writes its per-invocation profile here; see app_media/libreoffice.py
    HOME=/tmp

WORKDIR /app

# LibreOffice Impress is the render path (§4.3): its SVG export preserves <text>,
# where pdftocairo converts labels to paths and makes them unsearchable and
# useless to a screen reader.
#
# Fonts. Measured against a real house deck rather than guessed: Arial (192
# uses), Lato (116), then a long tail of Symbol, Wingdings and Windows UI faces.
#
#   fonts-liberation      metric-compatible with Arial, Times, Courier
#   fonts-lato            the house font — free, and the single biggest gap:
#                         without it 116 runs of text were laid out with the
#                         wrong metrics and overflowed their boxes
#   fonts-crosextra-*     Carlito/Caladea, metric-compatible with Calibri/Cambria
#   fonts-dejavu-core     broad Unicode coverage for the tail
#
# Verdana and the rest of the MS core fonts are still absent — not
# redistributable in an image without a licence (spec §14 decision 2) — but the
# deck uses Verdana twice, so this is now a rounding error rather than the
# problem it looked like. Symbol and Wingdings remain unsolved: they are symbol
# fonts, and a substitute renders different glyphs, not merely different metrics.
RUN apt-get update && apt-get install -y --no-install-recommends \
        libreoffice-impress \
        libreoffice-core \
        fonts-liberation \
        fonts-lato \
        fonts-crosextra-carlito \
        fonts-crosextra-caladea \
        fonts-dejavu-core \
        fontconfig \
        libcairo2 \
        libgl1 \
        libglib2.0-0 \
    && fc-cache -f \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-media.txt .
RUN pip install -r requirements-media.txt

COPY app_media ./app_media

# Warm LibreOffice's first-run profile at build time rather than paying it on the
# first real conversion, which would otherwise land inside a learner-visible job.
RUN soffice --headless --terminate_after_init -env:UserInstallation=file:///tmp/lo-warm || true

EXPOSE 8080
CMD ["uvicorn", "app_media.main:app", "--host", "0.0.0.0", "--port", "8080"]
